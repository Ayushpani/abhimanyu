<?xml version="1.0" encoding="utf-8"?>
<!-- Quiet outlined button: a hairline of ink, no fill. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/hairline">
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/ink" />
            <corners android:radius="4dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</ripple>
